# ============================================
# Build-time vs runtime
# ============================================
# BUILD-TIME: PUBLIC_HIVE_* variables are inlined into the bundle by Vite during
#   `astro build` / `docker build`. Changing them requires rebuilding the image;
#   setting them on a running container has no effect.
# RUNTIME: HIVE_USERNAME, CONFIG_PARENT_*, BRANDING_*, HOST, PORT, NODE_ENV and
#   PUBLIC_SITE_URL are read from the container environment (restart is enough).

# ============================================
# Required Configuration (runtime)
# ============================================

# Hive username whose posts will be displayed on the blog (personal blogs only)
HIVE_USERNAME=your-hive-username

# Public URL of this blog (canonical links, SEO)
# PUBLIC_SITE_URL=https://your-domain.com

# ============================================
# Optional Configuration (runtime)
# ============================================

# Config storage location on Hive blockchain (defaults to @barddev/my-blog-configs)
# CONFIG_PARENT_AUTHOR=barddev
# CONFIG_PARENT_PERMLINK=my-blog-configs

# Operator branding (empty = element not rendered; URLs must be http(s))
# BRANDING_NAME=BardDev
# BRANDING_URL=https://bard-dev.com
# BRANDING_KOFI_URL=https://ko-fi.com/your-name
# BRANDING_EDITOR_URL=https://your-editor.example.com

# ============================================
# Optional Configuration (build-time, rebuild required)
# ============================================

# Custom Hive API endpoint (defaults to https://api.openhive.network)
# PUBLIC_HIVE_API_ENDPOINT=https://api.hive.blog

# Hive chain ID (defaults to mainnet beeab0de..., set to 42 for mirrornet)
# PUBLIC_HIVE_CHAIN_ID=42

# Hive images proxy endpoint (defaults to https://images.hive.blog)
# PUBLIC_HIVE_IMAGES_ENDPOINT=https://images.hive.blog

# Hive blog base URL for profile/post links (defaults to https://blog.openhive.network)
# PUBLIC_HIVE_BLOG_URL=https://blog.openhive.network

# External signer app URL (defaults to https://signer.bard-dev.com, http://localhost:5174 in dev)
# PUBLIC_HIVE_SIGNER_URL=https://signer.bard-dev.com

# ============================================
# Docker Deployment Configuration
# ============================================

# Domain for Traefik reverse proxy (required for compose.yml deployment)
# DOMAIN=yourdomain.com

# ============================================
# Testing Configuration (E2E Tests)
# ============================================

# Hive credentials for Playwright E2E tests
# TEST_HIVE_USERNAME=testuser
# TEST_HIVE_PASSWORD=testpassword
# TEST_HIVE_WIF=
